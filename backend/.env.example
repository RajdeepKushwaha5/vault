# Coral runtime
# On Windows/WSL, this can point to a WSL command, for example:
# CORAL_BIN=wsl -d Ubuntu -e /home/YOUR_USER/.cargo/bin/coral
CORAL_BIN=coral
CORAL_CONFIG_DIR=/path/to/your/local/coral/config

# Optional Ask Vault synthesis
GEMINI_API_KEY_1=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Coral query guardrails
COMPASS_CORAL_QUERY_TIMEOUT_SECONDS=12
COMPASS_MAX_CORAL_QUERIES_PER_RUN=20
